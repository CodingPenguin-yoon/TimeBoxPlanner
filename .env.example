# Local only. URL-encode special characters in the database password.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://timebox:replace-with-local-password@localhost:5432/timebox?schema=public
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public signup. Use allowlist to restrict to AUTH_ALLOWED_EMAILS instead.
AUTH_REGISTRATION=open
AUTH_ALLOWED_EMAILS=
